FROM node:20-bullseye AS build
WORKDIR /workspace
COPY package*.json ./
COPY apps/dvs-app/package.json apps/dvs-app/package.json
COPY apps/dvs-app apps/dvs-app
RUN npm ci
WORKDIR /workspace/apps/dvs-app
ARG EXPO_PUBLIC_API_BASE_URL
ENV EXPO_PUBLIC_API_BASE_URL=${EXPO_PUBLIC_API_BASE_URL}
RUN npx expo export --platform web

FROM nginx:alpine
COPY infra/qa/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/dvs-app/dist /usr/share/nginx/html
