ARG NODE_VERSION=20.20.0

FROM node:${NODE_VERSION}-bullseye-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/dvs-app ./apps/dvs-app
COPY apps/dvs-desktop ./apps/dvs-desktop

RUN npm ci

ARG EXPO_PUBLIC_API_BASE_URL
ENV EXPO_PUBLIC_API_BASE_URL=${EXPO_PUBLIC_API_BASE_URL}
RUN npm --prefix apps/dvs-app run export:web

FROM nginx:alpine
COPY --from=build /app/apps/dvs-desktop/dist /usr/share/nginx/html
