ARG NODE_VERSION=20.20.0

FROM node:${NODE_VERSION}-bullseye-slim
WORKDIR /repo

ARG SERVICE_NAME
ARG SERVICE_DIR

COPY package.json package-lock.json nx.json tsconfig.base.json tsconfig.json ./
COPY . .

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
  && mkdir -p /etc/apt/keyrings \
  && curl -fsSL https://pgp.mongodb.com/server-7.0.asc | gpg --dearmor -o /etc/apt/keyrings/mongodb.gpg \
  && chmod 644 /etc/apt/keyrings/mongodb.gpg \
  && echo "deb [signed-by=/etc/apt/keyrings/mongodb.gpg] https://repo.mongodb.org/apt/debian bullseye/mongodb-org/7.0 main" \
    > /etc/apt/sources.list.d/mongodb-org-7.0.list \
  && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /etc/apt/keyrings/postgresql.gpg \
  && chmod 644 /etc/apt/keyrings/postgresql.gpg \
  && echo "deb [signed-by=/etc/apt/keyrings/postgresql.gpg] http://apt.postgresql.org/pub/repos/apt bullseye-pgdg main" \
    > /etc/apt/sources.list.d/pgdg.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends postgresql-client-16 mongodb-database-tools \
  && rm -rf /var/lib/apt/lists/*

RUN npm ci
RUN npx nx run @org/contracts:build
RUN npx nx run ${SERVICE_NAME}:build

ENV NODE_ENV=production
ENV SERVICE_DIR=${SERVICE_DIR}

CMD ["sh", "-c", "node ${SERVICE_DIR}/dist/main.js"]
